{
  "name": "haris",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deno": "deno test --allow-env --config supabase/functions/deno.json supabase/functions",
    "check:deno": "deno check supabase/functions/analyze-message/index.ts supabase/functions/scenario-feedback/index.ts supabase/functions/voice-debrief/index.ts && deno lint supabase/functions",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "preflight": "node scripts/preflight.mjs",
    "preflight:live": "node scripts/preflight.mjs --live",
    "probe:provider": "node scripts/probe-provider.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "description": "Cybersecurity awareness training for high school students: message analysis, attack scenarios, and vishing practice.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmo1177/HARIS.git"
  },
  "homepage": "https://github.com/bmo1177/HARIS#readme",
  "bugs": {
    "url": "https://github.com/bmo1177/HARIS/issues"
  },
  "keywords": [
    "cybersecurity",
    "security-awareness",
    "education",
    "phishing",
    "scam",
    "supabase"
  ],
  "packageManager": "npm@11.6.2"
}
