{
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "nodeModulesDir": "none"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-control-regex"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "../migrations"
    ]
  }
}
