# ---------------------------------------------------------------------------
# Client-side. These ARE bundled into the browser build — that is expected for
# the `VITE_` prefix. The Supabase *publishable* key is designed to be public;
# never put a secret key or a service-role key on this side.
#
# Two ways to reach the backend:
#
#   1. Supabase Edge Functions (the original deployment): set both VITE_SUPABASE_*
#      values below.
#   2. A standalone deployment of `server/main.ts` (Deno Deploy or a local
#      process): set VITE_HARIS_API_URL and the Supabase values become optional.
#
# VITE_HARIS_API_URL wins when both are set. It is a public URL, not a secret.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Optional. A deployed backend. Deno Deploy URLs look like
# https://<app>.<org>.deno.net; a local server is http://localhost:8000.
# VITE_HARIS_API_URL=

# ---------------------------------------------------------------------------
# Server-side. These are read by the backend (Supabase Edge Functions or the
# Deno server) and are never sent to the browser. Set them with:
#
#   supabase secrets set --env-file supabase/functions/.env.local
#
# (or `supabase secrets set KEY=value` one at a time). They are NOT read from
# the root `.env` — Vite's dotenv handling does not apply to Deno functions.
# ---------------------------------------------------------------------------

# Required. Any OpenAI-compatible provider works:
#   NVIDIA      https://integrate.api.nvidia.com/v1  (free, ~40 rpm)
#   OpenRouter  https://openrouter.ai/api/v1          (free tier capped at 50/day)
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   Together    https://api.together.xyz/v1
#   Ollama      http://localhost:11434/v1      (no key needed)
LLM_API_KEY=

# Optional overrides.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# The primary model, and then the fallbacks in priority order.
#
# Both were measured against the app's real analysis schema, on the real
# provider, for the four things that matter: the strict JSON schema is
# honoured, the risk band is right, the Arabic fields come back, and how long
# it takes. See the table in supabase/README.md for the full ranking.
#
# A model that is unavailable to your account, rejects the schema, times out or
# answers with something that is not JSON is skipped, and the next one is
# tried. The list shares one time budget, so a slow first model cannot make
# the fallback impossible.
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b

# Per attempt. A real analysis takes ~16s on the primary model when the free
# endpoint is quiet, and considerably longer when it is contended — the
# fallback list exists for exactly that. This is headroom for the tail, not a
# target.
LLM_TIMEOUT_MS=45000
# Across every model, for one request. The client waits this long before it
# gives up, so the two must agree. Two models fit: the first has an attempt,
# the second has what is left.
LLM_TOTAL_TIMEOUT_MS=90000
# 1200 truncates the Nemotron models mid-reasoning and returns invalid JSON.
LLM_MAX_TOKENS=4000

# NOTE: you probably do NOT need to set anything here.
#
# The Edge Function runtime already injects both of these:
#   SUPABASE_URL          the project URL
#   SUPABASE_SECRET_KEYS  a JSON dict of your secret keys, e.g. {"default":"sb_secret_..."}
#
# `_shared/env.ts` reads the secret key from `SUPABASE_SECRET_KEYS`, because
# Supabase is deprecating the legacy `anon` / `service_role` JWT keys that the
# `SUPABASE_SERVICE_ROLE_KEY` variable still carries.
#
# Only set these if you are running the functions outside the Supabase runtime.
# A secret key BYPASSES Row Level Security and has full project access — it must
# never reach the browser, a screenshot, or a chat log.
SUPABASE_URL=
SUPABASE_SECRET_KEYS=   # {"default":"sb_secret_..."}

# Comma-separated browser origins allowed to call the functions. Non-browser
# clients (curl, scripts) are not blocked by CORS — they are bounded by the rate
# limits below.
ALLOWED_ORIGINS=https://haris-two-xi.vercel.app,http://localhost:8080

# Per-client quotas. Defaults shown.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_RATE_LIMIT_MAX=100

# Where the counters live. Leave unset to choose automatically:
#   - Supabase when its URL and secret key are present (the original deployment);
#   - Deno KV on Deno Deploy;
#   - process memory locally.
#
# Set it explicitly when the automatic choice is not what you want. `memory` is
# per-process and resets on restart, so it is not a real quota on a serverless
# host; never select it for a public deployment.
# RATE_LIMIT_BACKEND=supabase   # or: kv, memory
